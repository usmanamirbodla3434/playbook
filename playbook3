---
- hosts: servers
  become: yes

  tasks:

    - name: Install httpd
      yum:
        name: httpd
        state: present

    - name: Start httpd
      service:
        name: httpd
        state: started
        enabled: yes

    - name: Copy index.html
      copy:
        src: index.html
        dest: /var/www/html/index.html
        mode: '0644'
      notify: Restart httpd

  handlers:

    - name: Restart httpd
      service:
        name: httpd
        state: restarted

